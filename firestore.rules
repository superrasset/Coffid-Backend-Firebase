rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Toute personne authentifiée (y compris anonymous) peut lire une tâche en attente.
    // Seul le backend (admin SDK) écrit dans cette collection.
    match /pendingRequest/{taskId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // L'utilisateur peut créer son propre document et le lire ensuite (polling / onSnapshot).
    // Seul le backend met à jour (validity, securityCheck, etc.).
    match /uploadedDocument/{docId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow read:   if request.auth != null
                    && request.auth.uid == resource.data.userId;
      allow update, delete: if false;
    }
  }
}
